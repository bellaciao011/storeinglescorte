{
  "installCommand": "npm i -g pnpm && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server run build:vercel && BASE_PATH=/ pnpm --filter @workspace/panini-mundial run build",
  "outputDirectory": "artifacts/panini-mundial/dist/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/dist/vercel/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
